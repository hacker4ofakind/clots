{
  "name": "clots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "image": "docker build -t clots-clot:dev docker",
    "spike": "node --env-file=.env --import tsx scripts/spike.ts",
    "daemon": "node --env-file=.env --import tsx src/daemon.ts",
    "deploy": "node scripts/deploy.mjs",
    "web": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:start": "npm run start -w web",
    "test:e2e": "npm run test:e2e -w web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@composio/core": "0.28.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "imapflow": "^2.4.2",
    "mailparser": "^3.9.39",
    "nodemailer": "^10.1.1",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "web",
    "packages/*"
  ]
}
